{
  "mainClass": "org.apache.spark.repl.Main?",
  "repositories": [
    "central"
  ],
  "dependencies": [
    "org.apache.spark::spark-repl:latest.stable",
    "org.slf4j:slf4j-nop:1.7.28"
  ],
  "exclusions": [
    "org.slf4j:slf4j-log4j12"
  ],
  "properties": {
    "scala.usejavacp": "true",
    "spark.master?": "local[*]",
    "spark.master": "local[*]"
  },
  "versionOverrides": [
    {
      "versionRange": "(,4.0.0-preview1)",
      "dependencies": [
        "org.apache.spark:spark-repl_2.12:latest.stable",
        "org.slf4j:slf4j-nop:1.7.28"
      ]
    }
  ]
}
